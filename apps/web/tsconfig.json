{
  "extends": "@opai/config/tsconfig.base.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", ".output"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@opai/ui/*": ["../../packages/ui/src/*"]
    }
  }
}
