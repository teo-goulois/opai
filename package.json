{
  "name": "opai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint": "oxlint apps packages",
    "format": "oxfmt apps packages",
    "check": "oxlint apps packages && oxfmt --check apps packages && turbo run check-types test"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.9"
  },
  "packageManager": "pnpm@10.33.0"
}
